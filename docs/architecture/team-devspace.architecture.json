  "cards": [
    {
      "dot": "cyan",
      "title": "运行、认证与事实源",
      "items": [
        "Access Key → D1 Device Binding → Device Secret → Bridge → Owner OAuth → 官方 DevSpace。",
        "D1 是云端绑定事实源，state.json 是设备状态；四类凭据职责分离。",
        "云端不持久化 MCP body/源码/Prompt/Shell；Allowed Roots 不是 Shell 沙箱。"
      ]
    },
    {
      "dot": "violet",
      "title": "薄实现与离线交付",
      "items": [
        "官方 DevSpace 保持原版；cloudflared、OS 启动和 Tray 均复用成熟能力，Tray 不做 supervisor。",
        "macOS arm64/Intel x64 共用 Codemagic M2 手动 workflow；Windows/Linux 在原生主机按需本地构建，均输出 SHA-256 离线包。",
        "安装验证候选后再切 active slot；失败保留当前版本，员工机不在线安装 runtime。"
      ]
    }
  ]
